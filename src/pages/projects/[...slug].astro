---
import ProjectDetailPage from '../../views/ProjectDetailPage.astro';
import type { Lang } from '../../i18n/ui';
import { getLocalizedCollection, getTranslation, entrySlug, entryKey } from '../../i18n/content';

export async function getStaticPaths() {
  const lang: Lang = 'en';
  const projects = await getLocalizedCollection('projects', lang);

  return projects.map((project) => ({
    params: { slug: entrySlug(project) },
    props: { project },
  }));
}

const { project } = Astro.props;

const idEntry = await getTranslation('projects', entryKey(project), 'id');
const enPath = `/projects/${entrySlug(project)}/`;
const idPath = idEntry ? `/id/projects/${entrySlug(idEntry)}/` : '/id/projects/';
---

<ProjectDetailPage lang="en" project={project} enPath={enPath} idPath={idPath} />
