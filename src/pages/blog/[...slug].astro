---
import BlogPostPage from '../../views/BlogPostPage.astro';
import type { Lang } from '../../i18n/ui';
import { getPosts, getTranslation, entrySlug, entryKey } from '../../i18n/content';

export async function getStaticPaths() {
  const lang: Lang = 'en';
  const posts = await getPosts(lang);

  return posts.map((post) => ({
    params: { slug: entrySlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;

const idEntry = await getTranslation('posts', entryKey(post), 'id');
const enPath = `/blog/${entrySlug(post)}/`;
const idPath = idEntry ? `/id/blog/${entrySlug(idEntry)}/` : '/id/blog/';
---

<BlogPostPage lang="en" post={post} enPath={enPath} idPath={idPath} />
