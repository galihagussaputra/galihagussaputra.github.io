---
import { useTranslations, type Lang, type UIKey } from '../i18n/ui';
import { localizePath, stripLocale } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items: { key: UIKey; path: string; icon: string }[] = [
  {
    key: 'nav.home',
    path: '/',
    icon: '<path d="M4 10.5 12 4l8 6.5V20a1 1 0 0 1-1 1h-4v-6H9v6H5a1 1 0 0 1-1-1z"/>',
  },
  {
    key: 'nav.about',
    path: '/about/',
    icon: '<circle cx="12" cy="8" r="3.25"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/>',
  },
  {
    key: 'nav.projects',
    path: '/projects/',
    icon: '<rect x="4" y="4" width="6.5" height="6.5" rx="0.5"/><rect x="13.5" y="4" width="6.5" height="6.5" rx="0.5"/><rect x="4" y="13.5" width="6.5" height="6.5" rx="0.5"/><rect x="13.5" y="13.5" width="6.5" height="6.5" rx="0.5"/>',
  },
  {
    key: 'nav.blog',
    path: '/blog/',
    icon: '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4M10 12h6M10 16h6"/>',
  },
  {
    key: 'nav.contact',
    path: '/contact/',
    icon: '<rect x="3.5" y="5.5" width="17" height="13" rx="1"/><path d="m4 6.5 8 6 8-6"/>',
  },
];

const current = stripLocale(Astro.url.pathname);
const isActive = (path: string) =>
  path === '/' ? current === '/' : current === path || current.startsWith(path);
---

<nav
  class="mobile-nav"
  id="mobile-nav"
  aria-label={lang === 'id' ? 'Navigasi utama' : 'Main navigation'}
>
  <ul>
    {items.map((item) => (
      <li>
        <a
          href={localizePath(item.path, lang)}
          class:list={['mobile-nav__link', { 'is-active': isActive(item.path) }]}
          aria-current={isActive(item.path) ? 'page' : undefined}
        >
          <span class="mobile-nav__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <Fragment set:html={item.icon} />
            </svg>
          </span>
          <span class="mobile-nav__label">{t(item.key)}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .mobile-nav {
    display: none;
  }

  @media (max-width: 900px) {
    .mobile-nav {
      position: fixed;
      right: 0;
      bottom: 0;
      left: 0;
      z-index: 70;
      display: block;
      border-top: 1px solid var(--border);
      background: color-mix(in srgb, var(--bg) 92%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      padding: 6px max(10px, env(safe-area-inset-right))
        calc(6px + env(safe-area-inset-bottom)) max(10px, env(safe-area-inset-left));
    }

    .mobile-nav ul {
      display: flex;
      align-items: stretch;
      justify-content: space-between;
      gap: 2px;
      width: 100%;
      max-width: 520px;
      margin-inline: auto;
    }

    .mobile-nav li {
      flex: 1 1 0;
      min-width: 0;
    }

    .mobile-nav__link {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      min-height: 48px;
      padding: 6px 2px;
      color: var(--text-secondary);
      transition: color var(--transition);
    }

    .mobile-nav__link:hover,
    .mobile-nav__link:focus-visible {
      color: var(--text);
    }

    .mobile-nav__link.is-active {
      color: var(--accent);
    }

    .mobile-nav__link.is-active::before {
      content: '';
      position: absolute;
      top: 0;
      left: 50%;
      width: 18px;
      height: 1px;
      background: currentColor;
      transform: translateX(-50%);
    }

    .mobile-nav__icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 20px;
      height: 20px;
    }

    .mobile-nav__icon svg {
      width: 100%;
      height: 100%;
    }

    .mobile-nav__label {
      max-width: 100%;
      overflow: hidden;
      font-family: var(--font-mono);
      font-size: 0.64rem;
      line-height: 1.2;
      letter-spacing: 0.04em;
      text-overflow: ellipsis;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .mobile-nav__link.is-active .mobile-nav__label {
      font-weight: 500;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-nav__link {
      transition: none;
    }
  }
</style>
