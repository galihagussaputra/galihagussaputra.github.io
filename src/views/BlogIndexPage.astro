---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';
import { localizePath, formatDate } from '../i18n/utils';
import { getPosts, entrySlug, readingTime } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts(lang);

const lead = posts[0];
const rest = posts.slice(1);

const title = lang === 'id' ? `Catatan — ${site.name}` : `Notes — ${site.name}`;
const description =
  lang === 'id'
    ? 'Esai dan catatan tentang pengembangan web, performa, dan kerajinan perangkat lunak.'
    : 'Essays and notes on web development, performance, and software craft.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: title,
  description,
  url: new URL(localizePath('/blog/', lang), site.url).toString(),
  inLanguage: lang,
  author: { '@type': 'Person', name: site.name },
};
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  enPath="/blog/"
  idPath="/id/blog/"
  jsonLd={jsonLd}
>
  <header class="page-head container">
    <div class="page-head__top">
      <p class="eyebrow">{t('blog.eyebrow')}</p>
      <span class="meta">{String(posts.length).padStart(2, '0')} {lang === 'id' ? 'catatan' : 'notes'}</span>
    </div>
    <h1 class="page-title">{t('blog.title')}</h1>
    <p class="page-lede">{t('blog.intro')}</p>
  </header>

  <section class="blog-section">
    <div class="container">
      {posts.length === 0 ? (
        <p class="muted">{t('blog.empty')}</p>
      ) : (
        <>
          {lead && (
            <a class="lead-post reveal" href={localizePath(`/blog/${entrySlug(lead)}/`, lang)}>
              <div class="lead-post__meta">
                <span class="mono">{t('blog.latest')}</span>
                <time class="mono" datetime={lead.data.pubDate.toISOString()}>
                  {formatDate(lead.data.pubDate, lang)}
                </time>
              </div>
              <h2>{lead.data.title}</h2>
              <p>{lead.data.description}</p>
              <div class="lead-post__foot">
                <ul class="tag-list">
                  {lead.data.tags.map((tag) => <li class="tag">{tag}</li>)}
                </ul>
                <span class="meta">
                  {readingTime(lead.body, lang)} {t('blog.readingTime')}
                </span>
              </div>
              <span class="lead-post__arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M6 18L18 6M9 6h9v9" fill="none" stroke="currentColor" stroke-width="1.3"></path>
                </svg>
              </span>
            </a>
          )}

          {rest.length > 0 && (
            <div class="post-list">
              <div class="post-list__head">
                <span class="eyebrow">{t('blog.all')}</span>
              </div>
              {rest.map((post, index) => (
                <a
                  class="post-row reveal"
                  href={localizePath(`/blog/${entrySlug(post)}/`, lang)}
                >
                  <span class="post-row__index">{String(index + 2).padStart(2, '0')}</span>
                  <div class="post-row__main">
                    <div class="post-row__heading">
                      <h2>{post.data.title}</h2>
                      <time class="meta" datetime={post.data.pubDate.toISOString()}>
                        {formatDate(post.data.pubDate, lang)}
                      </time>
                    </div>
                    <p>{post.data.description}</p>
                    <div class="post-row__foot">
                      <ul class="tag-list">
                        {post.data.tags.map((tag) => <li class="tag">{tag}</li>)}
                      </ul>
                      <span class="meta">{readingTime(post.body, lang)} {t('blog.readingTime')}</span>
                    </div>
                  </div>
                  <span class="post-row__arrow" aria-hidden="true">
                    <svg viewBox="0 0 24 24">
                      <path d="M6 18L18 6M9 6h9v9" fill="none" stroke="currentColor" stroke-width="1.3"></path>
                    </svg>
                  </span>
                </a>
              ))}
            </div>
          )}
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: clamp(48px, 7vw, 96px);
    padding-bottom: clamp(36px, 5vw, 64px);
    border-bottom: 1px solid var(--border);
  }

  .page-head__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .page-title {
    margin-top: 24px;
    font-size: var(--step-5);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.055em;
    max-width: 18ch;
  }

  .page-lede {
    margin-top: 24px;
    max-width: 56ch;
    color: var(--text-secondary);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .blog-section {
    padding-block: clamp(40px, 6vw, 80px) clamp(24px, 4vw, 48px);
  }

  .lead-post {
    position: relative;
    display: block;
    padding: clamp(28px, 5vw, 56px);
    background: var(--surface);
    border: 1px solid var(--border);
    transition: border-color var(--transition);
  }

  .lead-post:hover {
    border-color: var(--accent);
  }

  .lead-post__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding-bottom: 24px;
    margin-bottom: clamp(20px, 3vw, 32px);
    border-bottom: 1px solid var(--border);
    color: var(--accent);
  }

  .lead-post h2 {
    max-width: 22ch;
    padding-right: 48px;
    font-size: clamp(2rem, 4.4vw, 3.8rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.05em;
  }

  .lead-post > p {
    max-width: 56ch;
    margin-top: 20px;
    color: var(--text-secondary);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .lead-post__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 28px;
    flex-wrap: wrap;
  }

  .lead-post__arrow {
    position: absolute;
    top: clamp(28px, 5vw, 56px);
    right: clamp(28px, 5vw, 56px);
    color: var(--text-secondary);
    transition: color var(--transition), transform var(--transition);
  }

  .lead-post__arrow svg {
    width: 22px;
    height: 22px;
  }

  .lead-post:hover .lead-post__arrow {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  .post-list {
    margin-top: clamp(32px, 5vw, 56px);
  }

  .post-list__head {
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .post-row {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr) 32px;
    gap: clamp(16px, 3vw, 32px);
    padding: clamp(24px, 3.5vw, 38px) 0;
    border-bottom: 1px solid var(--border);
    transition: background-color var(--transition), padding-inline var(--transition);
  }

  .post-row:hover {
    background: var(--surface);
    padding-inline: clamp(8px, 1.5vw, 18px);
  }

  .post-row__index {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    padding-top: 8px;
  }

  .post-row__heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
  }

  .post-row__heading h2 {
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .post-row p {
    max-width: 60ch;
    margin-top: 12px;
    color: var(--text-secondary);
  }

  .post-row__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 18px;
    flex-wrap: wrap;
  }

  .post-row__arrow svg {
    width: 18px;
    height: 18px;
    margin-top: 6px;
    transition: transform var(--transition), color var(--transition);
  }

  .post-row:hover .post-row__arrow svg {
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  @media (max-width: 760px) {
    .post-row {
      grid-template-columns: 34px minmax(0, 1fr);
    }

    .post-row__arrow {
      display: none;
    }

    .post-row__heading {
      flex-direction: column;
      gap: 6px;
    }

    .post-row__foot {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .lead-post h2 {
      padding-right: 32px;
    }
  }
</style>
