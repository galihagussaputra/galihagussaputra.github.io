---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { useTranslations, type Lang, type UIKey } from '../i18n/ui';
import { localizePath, formatDate, formatYear } from '../i18n/utils';
import { getAbout, getProjects, getPosts, getSkillEntries, entrySlug, localizedSkill } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const statusLabel = (status: 'in-progress' | 'completed' | 'planned') =>
  t(`projects.status.${status}` as UIKey);
const statusClass = (status: 'in-progress' | 'completed' | 'planned') =>
  status === 'in-progress' ? 'status--progress' : status === 'planned' ? 'status--planned' : 'status--complete';

const about = await getAbout(lang);
const projects = (await getProjects(lang)).slice(0, 3);
const posts = (await getPosts(lang)).slice(0, 2);
const skills = (await getSkillEntries()).sort((a, b) => a.data.order - b.data.order);

const categories = Array.from(new Set(skills.map((skill) => skill.data.category)));
const skillGroups = categories.map((category) => ({
  category,
  items: skills.filter((skill) => skill.data.category === category),
}));

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  description: about.data.bio,
  url: site.url,
  email: `mailto:${site.email}`,
  sameAs: site.socials.map((social) => social.href),
  knowsAbout: ['Web applications', 'Backend systems', 'Database architecture', 'Business process automation'],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.brand,
  url: site.url,
  inLanguage: ['en', 'id'],
  author: { '@type': 'Person', name: site.name },
};
---

<BaseLayout
  title={`${site.name} — ${site.role}`}
  description={about.data.bio}
  lang={lang}
  enPath="/"
  idPath="/id/"
  jsonLd={[personJsonLd, websiteJsonLd]}
>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-main reveal">
        <p class="eyebrow">{t('home.eyebrow')}</p>
        <h1 class="hero-title">
          <span>{t('home.heroLead')}</span>
          <em>{t('home.heroAccent')}</em>
        </h1>
      </div>

      <aside class="hero-side reveal">
        <p class="hero-intro">{t('home.heroIntro')}</p>

        <div class="btn-row">
          <a href={localizePath('/projects/', lang)} class="btn btn--primary">
            {t('home.primaryCta')}
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4"></path>
            </svg>
          </a>
          <a href={localizePath('/contact/', lang)} class="btn btn--outline">{t('home.secondaryCta')}</a>
        </div>

        <dl class="hero-facts">
          <div>
            <dt>{t('home.roleLabel')}</dt>
            <dd>{about.data.role}</dd>
          </div>
          <div>
            <dt>{t('home.locationLabel')}</dt>
            <dd>{site.location}</dd>
          </div>
          <div>
            <dt>{t('home.experienceLabel')}</dt>
            <dd>{about.data.experienceYears}+ {t('home.years')}</dd>
          </div>
        </dl>

        <p class="availability status">{t('common.available')}</p>
      </aside>
    </div>

    <div class="container hero-foot" aria-hidden="true">
      <span>01 — Portfolio</span>
      <span>{site.location} · {new Date().getFullYear()}</span>
    </div>
  </section>

  <section class="section work-section">
    <div class="container">
      <header class="section-head reveal">
        <div>
          <p class="eyebrow">{t('home.selectedWork')}</p>
          <h2 class="section-title">{t('home.selectedWork')}</h2>
        </div>
        <p class="lede">{t('home.selectedWorkIntro')}</p>
        <a href={localizePath('/projects/', lang)} class="section-link link-underline">
          {t('home.viewAllProjects')}
        </a>
      </header>

      {projects.length === 0 ? (
        <p class="muted">{t('projects.empty')}</p>
      ) : (
        <div class="work-list">
          {projects.map((project, index) => (
            <a
              class="work-item reveal"
              href={localizePath(`/projects/${entrySlug(project)}/`, lang)}
            >
              <span class="work-index">{String(index + 1).padStart(2, '0')}</span>
              <div class="work-body">
                <div class="work-heading">
                  <h3>{project.data.title}</h3>
                  <span class="meta">{formatYear(project.data.pubDate)}</span>
                </div>
                <p class="work-description">{project.data.description}</p>
                <div class="work-meta">
                  <ul class="tag-list">
                    {project.data.tags.map((tag) => <li class="tag">{tag}</li>)}
                  </ul>
                  <span class:list={['status', statusClass(project.data.status)]}>
                    {statusLabel(project.data.status)}
                  </span>
                </div>
              </div>
              <span class="work-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M6 18L18 6M9 6h9v9" fill="none" stroke="currentColor" stroke-width="1.3"></path>
                </svg>
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="section section--surface about-band">
    <div class="container about-band-grid">
      <p class="eyebrow reveal">{t('home.aboutEyebrow')}</p>
      <div class="about-band-body reveal">
        <h2 class="statement">{t('home.aboutTitle')}</h2>
        <p class="lede">{about.data.bio}</p>
        <a href={localizePath('/about/', lang)} class="text-link">
          {t('home.readAbout')}
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <section class="section expertise-section">
    <div class="container">
      <header class="section-head reveal">
        <div>
          <p class="eyebrow">{t('home.expertiseEyebrow')}</p>
          <h2 class="section-title">{t('home.expertiseTitle')}</h2>
        </div>
        <p class="lede">{t('home.expertiseIntro')}</p>
      </header>

      <div class="expertise-grid">
        {skillGroups.map((group) => (
          <div class="expertise-column reveal">
            <h3>{group.category}</h3>
            <ul>
              {group.items.map((skill) => {
                const localized = localizedSkill(skill, lang);
                return (
                  <li>
                    <span class="expertise-name">{localized.title}</span>
                    <span class="expertise-detail">{localized.description}</span>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section writing-section">
    <div class="container">
      <header class="section-head reveal">
        <div>
          <p class="eyebrow">{t('home.writingEyebrow')}</p>
          <h2 class="section-title">{t('home.writingTitle')}</h2>
        </div>
        <p class="lede">{t('home.writingIntro')}</p>
        <a href={localizePath('/blog/', lang)} class="section-link link-underline">
          {t('home.readAllNotes')}
        </a>
      </header>

      {posts.length === 0 ? (
        <p class="muted">{t('blog.empty')}</p>
      ) : (
        <div class="writing-list">
          {posts.map((post) => (
            <a
              class="writing-item reveal"
              href={localizePath(`/blog/${entrySlug(post)}/`, lang)}
            >
              <time class="meta" datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate, lang)}
              </time>
              <div class="writing-body">
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <span class="writing-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4"></path>
                </svg>
              </span>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="contact-band">
    <div class="container">
      <p class="eyebrow reveal">{t('home.contactEyebrow')}</p>
      <div class="contact-band-grid reveal">
        <h2>{t('home.contactTitle')}</h2>
        <div class="contact-band-side">
          <p>{t('home.contactBody')}</p>
          <a href={`mailto:${site.email}`} class="contact-email">{site.email}</a>
          <a href={localizePath('/contact/', lang)} class="text-link">
            {t('home.contactCta')}
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: clamp(48px, 8vw, 112px) clamp(32px, 5vw, 56px);
    border-bottom: 1px solid var(--border);
    background-image: linear-gradient(to right, var(--border) 1px, transparent 1px);
    background-size: calc(100% / 6) 100%;
    background-position: center;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(280px, 0.72fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: end;
  }

  .hero-title {
    margin-top: clamp(24px, 4vw, 48px);
    font-size: var(--step-6);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.055em;
    max-width: 15ch;
  }

  .hero-title span {
    display: block;
  }

  .hero-title em {
    display: block;
    font-style: normal;
    color: var(--accent);
  }

  .hero-side {
    padding-bottom: 4px;
  }

  .hero-intro {
    color: var(--text-secondary);
    font-size: var(--step-1);
    line-height: 1.55;
    max-width: 40ch;
  }

  .hero-side .btn-row {
    margin-top: 28px;
  }

  .hero-facts {
    display: grid;
    gap: 0;
    margin-top: 32px;
    border-top: 1px solid var(--border);
  }

  .hero-facts div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }

  .hero-facts dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .hero-facts dd {
    font-size: 0.9rem;
    text-align: right;
  }

  .availability {
    margin-top: 20px;
  }

  .hero-foot {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: clamp(40px, 7vw, 88px);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .section-head {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr) auto;
    align-items: end;
    gap: clamp(20px, 4vw, 56px);
    margin-bottom: clamp(32px, 5vw, 56px);
  }

  .section-head .section-title {
    margin-top: 12px;
  }

  .section-link {
    align-self: end;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .work-list {
    border-top: 1px solid var(--border);
  }

  .work-item {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 40px;
    gap: clamp(16px, 3vw, 36px);
    padding: clamp(24px, 4vw, 40px) 0;
    border-bottom: 1px solid var(--border);
    transition: background-color var(--transition), padding-inline var(--transition);
  }

  .work-item:hover {
    background: var(--surface);
    padding-inline: clamp(8px, 1.5vw, 18px);
  }

  .work-index {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    padding-top: 8px;
  }

  .work-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
  }

  .work-heading h3 {
    font-size: clamp(1.7rem, 3.4vw, 2.9rem);
    font-weight: 500;
    letter-spacing: -0.045em;
  }

  .work-item:first-child .work-heading h3 {
    font-size: clamp(2rem, 4.2vw, 3.6rem);
  }

  .work-description {
    max-width: 58ch;
    margin-top: 12px;
    color: var(--text-secondary);
    font-size: 0.98rem;
  }

  .work-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 20px;
    flex-wrap: wrap;
  }

  .work-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-secondary);
    transition: border-color var(--transition), color var(--transition), transform var(--transition);
  }

  .work-arrow svg {
    width: 16px;
    height: 16px;
  }

  .work-item:hover .work-arrow {
    border-color: var(--accent);
    color: var(--accent);
    transform: translate(3px, -3px);
  }

  .about-band-grid {
    display: grid;
    grid-template-columns: minmax(120px, 0.35fr) minmax(0, 1.65fr);
    gap: clamp(24px, 5vw, 72px);
  }

  .statement {
    font-size: var(--step-5);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.05em;
    max-width: 16ch;
    margin-bottom: 28px;
  }

  .about-band-body .lede {
    max-width: 54ch;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--text);
  }

  .text-link svg {
    width: 15px;
    height: 15px;
    color: var(--accent);
    transition: transform var(--transition);
  }

  .text-link:hover svg {
    transform: translateX(4px);
  }

  .expertise-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 56px);
    border-top: 1px solid var(--border);
    padding-top: clamp(28px, 4vw, 48px);
  }

  .expertise-column h3 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border);
  }

  .expertise-column ul {
    display: grid;
  }

  .expertise-column li {
    padding: 18px 0;
    border-bottom: 1px solid var(--border);
  }

  .expertise-name {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  .expertise-detail {
    display: block;
    margin-top: 4px;
    color: var(--text-secondary);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .writing-list {
    border-top: 1px solid var(--border);
  }

  .writing-item {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr) 40px;
    gap: clamp(16px, 3vw, 36px);
    padding: clamp(22px, 3vw, 32px) 0;
    border-bottom: 1px solid var(--border);
    transition: padding-inline var(--transition), background-color var(--transition);
  }

  .writing-item:hover {
    background: var(--surface);
    padding-inline: clamp(8px, 1.5vw, 18px);
  }

  .writing-item time {
    padding-top: 6px;
  }

  .writing-body h3 {
    font-size: clamp(1.3rem, 2.2vw, 1.9rem);
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .writing-body p {
    margin-top: 8px;
    color: var(--text-secondary);
    font-size: 0.94rem;
    max-width: 62ch;
  }

  .writing-arrow {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;
    color: var(--text-secondary);
  }

  .writing-arrow svg {
    width: 18px;
    height: 18px;
    margin-top: 6px;
    transition: transform var(--transition), color var(--transition);
  }

  .writing-item:hover .writing-arrow svg {
    color: var(--accent);
    transform: translateX(4px);
  }

  .contact-band {
    padding-block: clamp(56px, 9vw, 120px);
    border-top: 1px solid var(--border);
  }

  .contact-band-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(28px, 6vw, 96px);
    align-items: end;
    margin-top: 24px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .contact-band h2 {
    font-size: var(--step-5);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.05em;
    max-width: 13ch;
  }

  .contact-band-side p {
    color: var(--text-secondary);
    max-width: 40ch;
  }

  .contact-email {
    display: inline-block;
    margin-top: 18px;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    letter-spacing: -0.02em;
    color: var(--text);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 2px;
  }

  .contact-email:hover {
    color: var(--accent);
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .hero-side {
      max-width: 620px;
    }

    .section-head {
      grid-template-columns: 1fr auto;
    }

    .section-head .lede {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .writing-item {
      grid-template-columns: 110px minmax(0, 1fr) 30px;
    }
  }

  @media (max-width: 820px) {
    .hero {
      background-image: none;
    }

    .work-item {
      grid-template-columns: 34px minmax(0, 1fr);
    }

    .work-arrow {
      display: none;
    }

    .expertise-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .expertise-column {
      padding-bottom: 12px;
    }

    .about-band-grid {
      grid-template-columns: 1fr;
    }

    .contact-band-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: clamp(2.9rem, 13vw, 4.2rem);
    }

    .section-head {
      grid-template-columns: 1fr;
    }

    .section-head .lede {
      grid-column: auto;
      grid-row: auto;
    }

    .section-link {
      justify-self: start;
    }

    .work-heading {
      flex-direction: column;
      gap: 6px;
    }

    .work-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 12px;
    }

    .writing-item {
      grid-template-columns: 1fr 24px;
    }

    .writing-item time {
      grid-column: 1 / -1;
      padding-top: 0;
    }

    .writing-arrow {
      align-items: center;
    }

    .writing-arrow svg {
      margin-top: 0;
    }

    .hero-foot {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>
