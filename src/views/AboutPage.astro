---
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';
import { getAbout, getSkillEntries, localizedSkill } from '../i18n/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const about = await getAbout(lang);
const { Content } = await render(about);
const skills = (await getSkillEntries()).sort((a, b) => a.data.order - b.data.order);
const categories = Array.from(new Set(skills.map((skill) => skill.data.category)));

const blocks = [
  { title: t('about.philosophyTitle'), body: t('about.philosophyBody') },
  { title: t('about.approachTitle'), body: t('about.approachBody') },
  { title: t('about.interestsTitle'), body: t('about.interestsBody') },
  { title: t('about.journeyTitle'), body: t('about.journeyBody') },
];

const title = lang === 'id' ? `Tentang — ${site.name}` : `About — ${site.name}`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    jobTitle: site.role,
    description: about.data.bio,
    url: new URL(localizePath('/about/', lang), site.url).toString(),
    email: `mailto:${site.email}`,
    sameAs: site.socials.map((social) => social.href),
  },
};
---

<BaseLayout
  title={title}
  description={about.data.bio}
  lang={lang}
  enPath="/about/"
  idPath="/id/about/"
  type="profile"
  jsonLd={jsonLd}
>
  <header class="page-head container">
    <p class="eyebrow">{t('about.eyebrow')}</p>
    <h1 class="page-title">{t('about.title')}</h1>
    <p class="page-lede">{about.data.heroSubtitle}</p>
  </header>

  <section class="about-section">
    <div class="container about-grid">
      <aside class="about-aside reveal">
        <dl class="about-meta">
          <div>
            <dt>{t('about.metaName')}</dt>
            <dd>{about.data.name}</dd>
          </div>
          <div>
            <dt>{t('about.metaRole')}</dt>
            <dd>{about.data.role}</dd>
          </div>
          <div>
            <dt>{t('about.metaExperience')}</dt>
            <dd>{about.data.experienceYears}+ {t('home.years')}</dd>
          </div>
          <div>
            <dt>{t('about.metaLocation')}</dt>
            <dd>{site.location}</dd>
          </div>
          <div>
            <dt>{t('about.metaStatus')}</dt>
            <dd class="status">{t('common.available')}</dd>
          </div>
        </dl>

        <div class="aside-expertise">
          <p class="eyebrow">{t('home.expertiseEyebrow')}</p>
          <ul>
            {categories.map((category) => {
              const group = skills.filter((skill) => skill.data.category === category);
              return (
                <li>
                  <span class="aside-category">{category}</span>
                  <span class="aside-items">
                    {group.map((skill) => localizedSkill(skill, lang).title).join(' · ')}
                  </span>
                </li>
              );
            })}
          </ul>
        </div>
      </aside>

      <div class="about-main">
        <article class="prose about-prose reveal">
          <Content />
        </article>

        <div class="about-blocks">
          {blocks.map((block, index) => (
            <section class="about-block reveal">
              <span class="about-block__index">0{index + 1}</span>
              <div>
                <h2>{block.title}</h2>
                <p>{block.body}</p>
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="about-cta">
    <div class="container about-cta__grid reveal">
      <h2>{t('about.ctaTitle')}</h2>
      <div>
        <p>{t('about.ctaBody')}</p>
        <a href={localizePath('/contact/', lang)} class="btn btn--primary">
          {t('about.cta')}
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: clamp(48px, 7vw, 96px);
    padding-bottom: clamp(32px, 5vw, 64px);
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    margin-top: 24px;
    font-size: var(--step-5);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.055em;
    max-width: 18ch;
  }

  .page-lede {
    margin-top: 24px;
    max-width: 56ch;
    color: var(--text-secondary);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .about-section {
    padding-block: clamp(48px, 7vw, 96px);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(220px, 0.42fr) minmax(0, 1fr);
    gap: clamp(32px, 7vw, 112px);
    align-items: start;
  }

  .about-aside {
    position: sticky;
    top: calc(var(--nav-height) + 32px);
  }

  .about-meta {
    border-top: 1px solid var(--border);
  }

  .about-meta div {
    display: grid;
    gap: 4px;
    padding: 13px 0;
    border-bottom: 1px solid var(--border);
  }

  .about-meta dt {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .about-meta dd {
    font-size: 0.92rem;
  }

  .aside-expertise {
    margin-top: 36px;
  }

  .aside-expertise ul {
    margin-top: 14px;
    border-top: 1px solid var(--border);
  }

  .aside-expertise li {
    display: grid;
    gap: 3px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }

  .aside-category {
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .aside-items {
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .about-prose {
    max-width: 66ch;
  }

  .about-block {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: clamp(12px, 2vw, 24px);
    padding-block: clamp(28px, 4vw, 44px);
    border-top: 1px solid var(--border);
  }

  .about-blocks {
    margin-top: clamp(40px, 6vw, 72px);
    border-bottom: 1px solid var(--border);
  }

  .about-block__index {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    padding-top: 6px;
  }

  .about-block h2 {
    font-size: var(--step-3);
    font-weight: 500;
    letter-spacing: -0.04em;
    margin-bottom: 14px;
  }

  .about-block p {
    max-width: 62ch;
    color: var(--text-secondary);
  }

  .about-cta {
    padding-block: clamp(48px, 8vw, 96px);
    border-top: 1px solid var(--border);
  }

  .about-cta__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: end;
  }

  .about-cta h2 {
    font-size: var(--step-4);
    font-weight: 500;
    letter-spacing: -0.045em;
    max-width: 14ch;
  }

  .about-cta p {
    color: var(--text-secondary);
    max-width: 42ch;
    margin-bottom: 24px;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }

    .about-aside {
      position: static;
    }

    .aside-expertise {
      margin-top: 28px;
    }

    .about-cta__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .about-block {
      grid-template-columns: 1fr;
    }

    .about-block__index {
      padding-top: 0;
    }
  }
</style>
