---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { useTranslations, type Lang } from '../i18n/ui';
import { localizePath } from '../i18n/utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const title = lang === 'id' ? `Kontak — ${site.name}` : `Contact — ${site.name}`;
const description =
  lang === 'id'
    ? 'Hubungi Galih Agus Saputra untuk kolaborasi, diskusi proyek, atau kesempatan kerja.'
    : 'Get in touch with Galih Agus Saputra for collaboration, project discussions, or work opportunities.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: title,
  description,
  url: new URL(localizePath('/contact/', lang), site.url).toString(),
  mainEntity: {
    '@type': 'Person',
    name: site.name,
    email: `mailto:${site.email}`,
    url: site.url,
    sameAs: site.socials.map((social) => social.href),
  },
};
---

<BaseLayout
  title={title}
  description={description}
  lang={lang}
  enPath="/contact/"
  idPath="/id/contact/"
  jsonLd={jsonLd}
>
  <header class="page-head container">
    <p class="eyebrow">{t('contact.eyebrow')}</p>
    <h1 class="page-title">{t('contact.title')}</h1>
    <p class="page-lede">{t('contact.intro')}</p>
    <p class="status contact-status">{t('common.available')}</p>
  </header>

  <section class="contact-section">
    <div class="container contact-grid">
      <aside class="contact-direct reveal">
        <div class="direct-block">
          <p class="eyebrow">{t('contact.email')}</p>
          <a href={`mailto:${site.email}`} class="direct-email">{site.email}</a>
          <p class="direct-copy">{t('contact.directBody')}</p>
        </div>

        <div class="direct-block">
          <p class="eyebrow">{t('contact.social')}</p>
          <ul class="social-list">
            {site.socials.map((social) => (
              <li>
                <a href={social.href} target="_blank" rel="noopener noreferrer">
                  <span>{social.label}</span>
                  <span class="social-handle">{social.handle}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6 18L18 6M9 6h9v9" fill="none" stroke="currentColor" stroke-width="1.3"></path>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>

      <div class="contact-form-wrap reveal">
        <div class="form-head">
          <h2>{t('contact.directTitle')}</h2>
          <p>{t('contact.formNote')}</p>
        </div>

        <form class="contact-form" method="POST" action={localizePath('/contact/', lang)} data-email={site.email}>
          <div class="form-row">
            <div class="form-group">
              <label for="name">{t('contact.formName')}</label>
              <input
                type="text"
                id="name"
                name="name"
                placeholder={t('contact.placeholderName')}
                autocomplete="name"
                required
              />
            </div>
            <div class="form-group">
              <label for="email">{t('contact.formEmail')}</label>
              <input
                type="email"
                id="email"
                name="email"
                placeholder={t('contact.placeholderEmail')}
                autocomplete="email"
                required
              />
            </div>
          </div>

          <div class="form-group">
            <label for="subject">{t('contact.formSubject')}</label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder={t('contact.placeholderSubject')}
              required
            />
          </div>

          <div class="form-group">
            <label for="message">{t('contact.formMessage')}</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              placeholder={t('contact.placeholderMessage')}
              required
            ></textarea>
          </div>

          <button type="submit" class="btn btn--primary">
            {t('contact.formSend')}
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4"></path>
            </svg>
          </button>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-top: clamp(48px, 7vw, 96px);
    padding-bottom: clamp(36px, 5vw, 64px);
    border-bottom: 1px solid var(--border);
  }

  .page-title {
    margin-top: 24px;
    font-size: var(--step-5);
    font-weight: 500;
    line-height: 0.95;
    letter-spacing: -0.055em;
    max-width: 16ch;
  }

  .page-lede {
    margin-top: 24px;
    max-width: 56ch;
    color: var(--text-secondary);
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .contact-status {
    margin-top: 24px;
  }

  .contact-section {
    padding-block: clamp(40px, 6vw, 80px);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(40px, 7vw, 112px);
    align-items: start;
  }

  .direct-block {
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }

  .direct-block + .direct-block {
    margin-top: 40px;
  }

  .direct-email {
    display: inline-block;
    margin-top: 16px;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.7rem);
    letter-spacing: -0.03em;
    color: var(--text);
    border-bottom: 1px solid var(--accent);
    padding-bottom: 3px;
    word-break: break-word;
  }

  .direct-email:hover {
    color: var(--accent);
  }

  .direct-copy {
    margin-top: 16px;
    color: var(--text-secondary);
    font-size: 0.9rem;
    max-width: 38ch;
  }

  .social-list {
    display: grid;
    margin-top: 14px;
    border-top: 1px solid var(--border);
  }

  .social-list a {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr) 20px;
    align-items: center;
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 0.9rem;
  }

  .social-list a:hover {
    color: var(--accent);
  }

  .social-handle {
    color: var(--text-secondary);
    font-size: 0.82rem;
    overflow-wrap: anywhere;
  }

  .social-list svg {
    width: 15px;
    height: 15px;
    color: var(--accent);
  }

  .form-head {
    margin-bottom: 24px;
  }

  .form-head h2 {
    font-size: var(--step-2);
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .form-head p {
    margin-top: 8px;
    color: var(--text-secondary);
    font-size: 0.86rem;
    max-width: 52ch;
  }

  .contact-form {
    display: grid;
    gap: 18px;
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .form-group {
    display: grid;
    gap: 7px;
  }

  .form-group label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 2px;
    background: transparent;
    color: var(--text);
    font-size: 0.94rem;
    transition: border-color var(--transition), background-color var(--transition);
  }

  .form-group textarea {
    resize: vertical;
    min-height: 140px;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: color-mix(in srgb, var(--text-secondary) 70%, transparent);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--accent);
    background: var(--surface);
  }

  .contact-form .btn {
    justify-self: start;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .form-row {
      grid-template-columns: 1fr;
    }

    .social-list a {
      grid-template-columns: 80px minmax(0, 1fr) 18px;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const email = form.dataset.email ?? '';
    const subject = encodeURIComponent(String(data.get('subject') || 'Message from portfolio'));
    const body = encodeURIComponent(
      `Hello Galih,\n\n${data.get('message')}\n\n— ${data.get('name')} (${data.get('email')})`
    );
    window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
  });
</script>
